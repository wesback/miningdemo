// =============================================================================
// Mining Real-Time Intelligence — Predictive & Advanced Analytics Queries
// These use KQL's built-in time-series ML functions for forecasting,
// anomaly detection, trend decomposition, and failure prediction.
//
// NOTE: Queries 4 (RUL) and 7 (Belt Wear) use a 7-day lookback window.
// In a fresh demo environment, run the simulator for at least 1-2 hours
// before expecting meaningful results. For best demo impact, adjust the
// lookback to match your available data: e.g., change "7d" to "2h".
// =============================================================================


// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║  1. ENGINE TEMPERATURE FORECAST (series_decompose_forecast)              ║
// ║  Predicts engine temp 2 hours into the future per truck.                ║
// ║  Helps engineers see which trucks are trending toward overheat.          ║
// ╚═══════════════════════════════════════════════════════════════════════════╝
let forecast_points = 24;  // 24 x 5-min bins = 2 hours ahead
EquipmentTelemetry
| where SensorType == "engine_temp_c"
    and EquipmentType == "haul_truck"
    and Timestamp > ago(12h)
    and Quality == "good"
| make-series AvgTemp = avg(Value) default = real(null)
    on Timestamp from ago(12h) to now() + 2h step 5m
    by EquipmentId
| extend (ForecastTemp, MinTemp, MaxTemp) = series_decompose_forecast(AvgTemp, forecast_points)
| project EquipmentId, Timestamp, AvgTemp, ForecastTemp, MinTemp, MaxTemp


// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║  2. VIBRATION ANOMALY SCORING (series_decompose_anomalies)              ║
// ║  ML-based anomaly detection with severity score per reading.            ║
// ║  More accurate than static 3σ — adapts to seasonal/trend components.    ║
// ╚═══════════════════════════════════════════════════════════════════════════╝
EquipmentTelemetry
| where SensorType == "vibration_mm_s"
    and EquipmentType == "conveyor"
    and Timestamp > ago(24h)
    and Quality == "good"
| make-series VibrationSeries = avg(Value) default = real(null)
    on Timestamp from ago(24h) to now() step 1m
    by EquipmentId
| extend (AnomalyFlags, AnomalyScore, Baseline) = series_decompose_anomalies(VibrationSeries)
| mv-expand Timestamp to typeof(datetime),
            VibrationSeries to typeof(real),
            AnomalyFlags to typeof(int),
            AnomalyScore to typeof(real),
            Baseline to typeof(real)
| where AnomalyFlags != 0
| project Timestamp, EquipmentId, VibrationValue = round(VibrationSeries, 2),
          Baseline = round(Baseline, 2), AnomalyScore = round(AnomalyScore, 2),
          Direction = iff(AnomalyFlags > 0, "Spike", "Drop")
| order by abs(AnomalyScore) desc


// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║  3. HYDRAULIC PRESSURE TREND PREDICTION (Linear Regression)             ║
// ║  Fits a regression line to recent pressure data per drill.              ║
// ║  Predicts when pressure will cross the 1500 PSI critical threshold.     ║
// ╚═══════════════════════════════════════════════════════════════════════════╝
let critical_psi = 1500.0;
EquipmentTelemetry
| where SensorType == "hydraulic_psi"
    and EquipmentType == "drill"
    and Timestamp > ago(6h)
    and Quality == "good"
| make-series PressureSeries = avg(Value) default = real(null)
    on Timestamp from ago(6h) to now() step 5m
    by EquipmentId
| extend (Slope, Intercept, R2, Variance) = series_fit_line(PressureSeries)
| extend CurrentPressure = toreal(PressureSeries[-1])
| extend TrendDirection = iff(Slope < 0, "Declining", "Stable/Rising")
// Estimate hours until threshold breach (if declining)
| extend HoursToThreshold = iff(Slope < 0,
    round((critical_psi - CurrentPressure) / (Slope * 12.0), 1),  // 12 bins/hr at 5m step
    real(null))
| project EquipmentId,
          CurrentPressure = round(CurrentPressure, 0),
          TrendDirection,
          SlopePerHour = round(Slope * 12.0, 1),
          R2 = round(R2, 3),
          HoursToThreshold,
          Risk = case(
              HoursToThreshold between (0.0 .. 2.0), "CRITICAL — breach within 2 hours",
              HoursToThreshold between (2.0 .. 6.0), "WARNING — breach within 6 hours",
              Slope < 0, "WATCH — declining trend",
              "OK")
| order by HoursToThreshold asc


// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║  4. REMAINING USEFUL LIFE ESTIMATION (Multi-Sensor Degradation)         ║
// ║  Combines engine temp trend + oil pressure variance + vibration drift   ║
// ║  to estimate days until maintenance is required per truck.              ║
// ╚═══════════════════════════════════════════════════════════════════════════╝
let lookback = 7d;
// Data sufficiency check: ensure enough data exists for meaningful ML computation
let data_check = EquipmentTelemetry
    | where SensorType in ("engine_temp_c", "oil_pressure_kpa", "vibration_mm_s")
        and EquipmentType == "haul_truck"
        and Timestamp > ago(lookback)
        and Quality == "good"
    | summarize DataPoints = count(),
                TimeSpan = datetime_diff('day', max(Timestamp), min(Timestamp)),
                AssetCount = dcount(EquipmentId);
let has_sufficient_data = toscalar(data_check
    | project IsSufficient = (DataPoints >= 100 and TimeSpan >= 1));
// Temperature degradation: rising trend = degradation
let TempTrend = EquipmentTelemetry
    | where SensorType == "engine_temp_c" and EquipmentType == "haul_truck"
        and Timestamp > ago(lookback) and Quality == "good"
    | make-series TempSeries = avg(Value) on Timestamp from ago(lookback) to now() step 1h
        by EquipmentId
    | extend (TempSlope, TempIntercept, TempR2, TempVariance) = series_fit_line(TempSeries)
    | project EquipmentId, TempSlope, TempR2;
// Oil pressure degradation: increasing variance = degradation
let OilHealth = EquipmentTelemetry
    | where SensorType == "oil_pressure_kpa" and EquipmentType == "haul_truck"
        and Timestamp > ago(lookback) and Quality == "good"
    | summarize OilStd = stdev(Value), OilMean = avg(Value) by EquipmentId
    | extend OilCV = OilStd / OilMean;  // coefficient of variation
// Vibration degradation: rising trend = bearing wear
let VibTrend = EquipmentTelemetry
    | where SensorType == "vibration_mm_s" and EquipmentType == "haul_truck"
        and Timestamp > ago(lookback) and Quality == "good"
    | make-series VibSeries = avg(Value) on Timestamp from ago(lookback) to now() step 1h
        by EquipmentId
    | extend (VibSlope, VibIntercept, VibR2, VibVariance) = series_fit_line(VibSeries)
    | project EquipmentId, VibSlope, VibR2;
let rul_results = TempTrend
| join kind=leftouter OilHealth on EquipmentId
| join kind=leftouter VibTrend on EquipmentId
| extend TempDegradation  = min_of(1.0, max_of(0.0, TempSlope * 100.0))
| extend OilDegradation   = min_of(1.0, max_of(0.0, (OilCV - 0.05) * 10.0))
| extend VibDegradation   = min_of(1.0, max_of(0.0, VibSlope * 50.0))
| extend DegradationIndex = round(
    (TempDegradation * 0.35) + (OilDegradation * 0.35) + (VibDegradation * 0.30), 3)
| extend EstimatedRUL_Days = case(
    DegradationIndex > 0.8, round(3.0 / DegradationIndex, 0),
    DegradationIndex > 0.5, round(14.0 / DegradationIndex, 0),
    DegradationIndex > 0.2, round(30.0 / DegradationIndex, 0),
    real(180))
| project
    Message = "✓ Sufficient data — proceeding with RUL estimation",
    DataPoints = long(null),
    TimeSpan = real(null),
    AssetCount = long(null),
    EquipmentId,
    DegradationIndex,
    TempDegradation = round(TempDegradation, 3),
    OilDegradation = round(OilDegradation, 3),
    VibDegradation = round(VibDegradation, 3),
    EstimatedRUL_Days,
    MaintenancePriority = case(
        EstimatedRUL_Days <= 7,  "URGENT",
        EstimatedRUL_Days <= 21, "PLAN",
        "ROUTINE");
union
(
    data_check
    | where not(has_sufficient_data)
    | extend Message = strcat("⚠ INSUFFICIENT DATA — Only ", DataPoints, " points over ", TimeSpan,
           " days. Run simulator for longer or reduce lookback window.")
    | project
        Message,
        DataPoints,
        TimeSpan,
        AssetCount,
        EquipmentId = "",
        DegradationIndex = real(null),
        TempDegradation = real(null),
        OilDegradation = real(null),
        VibDegradation = real(null),
        EstimatedRUL_Days = real(null),
        MaintenancePriority = ""
),
(
    rul_results
    | where has_sufficient_data
)
| order by coalesce(EstimatedRUL_Days, real(9999)) asc, EquipmentId asc

// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║  5. PRODUCTION FORECAST (series_decompose_forecast)                     ║
// ║  Forecasts shift-end tonnage based on current rate.                     ║
// ║  Lets ops manager know whether the shift will hit target.               ║
// ╚═══════════════════════════════════════════════════════════════════════════╝
let shift_target = 5000.0;
let shift_hours = 8h;
let forecast_bins = 16;  // remaining bins to forecast (assume mid-shift)
ProductionMetrics
| where SensorType == "load_tonnes"
    and Timestamp > ago(shift_hours)
    and Quality == "good"
| make-series TonnageSeries = sum(Value) default = 0.0
    on Timestamp from ago(shift_hours) to now() + 4h step 30m
    by EquipmentType
| extend (ForecastTonnage, Lo, Hi) = series_decompose_forecast(TonnageSeries, forecast_bins)
// Sum the forecast series to get projected total
| extend ProjectedTotal = series_sum(ForecastTonnage)
| extend CurrentTotal = series_sum(TonnageSeries)
| project EquipmentType,
          CurrentTonnes = round(CurrentTotal, 0),
          ProjectedTonnes = round(ProjectedTotal, 0),
          Target = shift_target,
          WillMeetTarget = ProjectedTotal >= shift_target,
          ProjectedPct = round(ProjectedTotal / shift_target * 100, 1)


// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║  6. GAS LEVEL TREND FORECAST (Early Warning)                            ║
// ║  Forecasts CO/CH₄ levels 30 min ahead.                                 ║
// ║  Fires pre-alerts before concentrations actually breach thresholds.     ║
// ╚═══════════════════════════════════════════════════════════════════════════╝
let co_threshold = 35.0;
let ch4_threshold = 1.0;
let forecast_points = 6;  // 6 x 5-min = 30 min ahead
EnvironmentalReadings
| where SensorType in ("co_ppm", "ch4_pct")
    and Timestamp > ago(4h)
    and Quality == "good"
| make-series GasSeries = avg(Value) default = real(null)
    on Timestamp from ago(4h) to now() + 30m step 5m
    by Zone, SensorType
| extend (Forecast, Lo, Hi) = series_decompose_forecast(GasSeries, forecast_points)
// Get the max forecasted value in the prediction window
| extend ForecastedPeak = series_stats_dynamic(Forecast).max
| extend Threshold = iff(SensorType == "co_ppm", co_threshold, ch4_threshold)
| where ForecastedPeak > Threshold * 0.8  // alert at 80% of threshold (pre-warning)
| project Zone, SensorType,
          CurrentValue = round(toreal(GasSeries[-forecast_points - 1]), 2),
          ForecastedPeak = round(ForecastedPeak, 2),
          Threshold,
          PctOfThreshold = round(ForecastedPeak / Threshold * 100, 1),
          Risk = case(
              ForecastedPeak > Threshold, "BREACH PREDICTED within 30 min",
              ForecastedPeak > Threshold * 0.9, "APPROACHING — within 90% of limit",
              "ELEVATED — within 80% of limit")
| order by PctOfThreshold desc


// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║  7. CONVEYOR BELT WEAR DETECTION (Periodicity + Trend)                  ║
// ║  Detects changes in vibration periodicity that indicate belt wear,      ║
// ║  splice damage, or roller degradation.                                  ║
// ╚═══════════════════════════════════════════════════════════════════════════╝
// Data sufficiency check: 7-day lookback requires adequate historical data
let belt_lookback = 7d;
let belt_data_check = EquipmentTelemetry
    | where SensorType == "vibration_mm_s"
        and EquipmentType == "conveyor"
        and Timestamp > ago(belt_lookback)
        and Quality == "good"
    | summarize DataPoints = count(),
                TimeSpan = datetime_diff('day', max(Timestamp), min(Timestamp)),
                ConveyorCount = dcount(EquipmentId);
let belt_has_data = toscalar(belt_data_check
    | project IsSufficient = (DataPoints >= 100 and TimeSpan >= 1));
let belt_results = EquipmentTelemetry
| where SensorType == "vibration_mm_s"
    and EquipmentType == "conveyor"
    and Timestamp > ago(belt_lookback)
    and Quality == "good"
| make-series VibSeries = avg(Value) default = real(null)
    on Timestamp from ago(belt_lookback) to now() step 1m
    by EquipmentId
| extend (Periods, PeriodScores) = series_periods_detect(VibSeries, 2.0, 1440.0, 2)
| extend (Flags, Scores, Baseline) = series_decompose_anomalies(VibSeries)
| extend (Slope, Intercept, R2, Variance) = series_fit_line(VibSeries)
| project
    Message = "✓ Sufficient data — proceeding with belt wear analysis",
    DataPoints = long(null),
    TimeSpan = real(null),
    ConveyorCount = long(null),
    EquipmentId,
    DetectedPeriods = Periods,
    PeriodConfidence = PeriodScores,
    TrendSlope = round(Slope * 60.0, 4),
    TrendR2 = round(R2, 3),
    WearIndicator = case(
        Slope > 0.001,  "DEGRADING — vibration trending upward",
        Slope < -0.001, "IMPROVING — post-maintenance settling",
        "STABLE");
union
(
    belt_data_check
    | where not(belt_has_data)
    | extend Message = strcat("⚠ INSUFFICIENT DATA — Only ", DataPoints, " points over ", TimeSpan,
           " days. Adjust lookback window or run simulator longer.")
    | project
        Message,
        DataPoints,
        TimeSpan,
        ConveyorCount,
        EquipmentId = "",
        DetectedPeriods = dynamic(null),
        PeriodConfidence = dynamic(null),
        TrendSlope = real(null),
        TrendR2 = real(null),
        WearIndicator = ""
),
(
    belt_results
    | where belt_has_data
)
| order by coalesce(TrendSlope, real(9999)) desc, EquipmentId asc
